# Domain
# This would be set to the production domain with an env var on deployment
# used by Traefik to transmit traffic and acquire TLS certificates
DOMAIN=localhost
# To test the local Traefik config
# DOMAIN=localhost.tiangolo.com

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://localhost:5173
# In staging and production, set this env var to the frontend host, e.g.
# FRONTEND_HOST=https://dashboard.example.com

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME="Groundwork AI Research Assistant"
STACK_NAME=groundwork-ai-research-assistant

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost.tiangolo.com"
SECRET_KEY=changedthisforgroundwork
FIRST_SUPERUSER=admin@groundwork-research.com
FIRST_SUPERUSER_PASSWORD=changedthisforgroundwork

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=groundwork
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changedthisforgroundwork

SENTRY_DSN=

# Object storage (S3-compatible; MinIO locally, R2/S3 in production)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=groundwork-documents
S3_REGION=auto

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=groundwork_server
DOCKER_IMAGE_FRONTEND=groundwork_ui
